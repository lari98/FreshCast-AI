{
  "name": "freshcast-dashboard",
  "version": "0.4.0",
  "private": true,
  "description": "FreshCast AI planner dashboard (demo-data driven, optional API source).",
  "scripts": {
    "predev": "node scripts/write-version.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/write-version.mjs",
    "build": "next build",
    "serve": "node scripts/static-server.mjs out",
    "test:scripts": "node --test scripts/static-server.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.0",
    "axe-core": "4.11.0",
    "eslint": "9.39.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
